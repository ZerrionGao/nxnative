# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/

# Local game inputs, credentials, generated builds, and signed artifacts
/Games/*/input/
!/Games/*/input/README.md
!/Games/*/input/keys/
!/Games/*/input/keys/README.md
/Games/*/artifacts/
/Games/*/assets/
/Games/opensource-ktgl-ports/
*.keys
!**/keys/README.md
.codegraph/
*.xci
*.ipa
*.mobileprovision
*.p12
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# coverage.py data and its JSON report (pyproject.toml, [tool.coverage.run])
.coverage
.coverage.*
/coverage.json

# Private local credentials and game packages (source-only distribution)
/keys/
.env
.env.*
!.env.example
*.nsp
*.nsz
*.xcz
*.nca
*.pfx
*.p8
*.pem
*.key
*.cer
*.der
*.provisionprofile

# Local alternate-region extraction outside the standard input directory
/Games/diablo3/us/
